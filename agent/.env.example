# Chainlit Configuration
CHAINLIT_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
CHAINLIT_USERNAME=admin
CHAINLIT_PASSWORD=admin
DATABASE_URL=postgresql+asyncpg://chainlit:chainlit@postgres:5432/chainlit
POSTGRES_DB=chainlit
POSTGRES_USER=chainlit
POSTGRES_PASSWORD=chainlit

# Headless Assistant API
# Leave empty for local development. Set in production and configure the Grafana
# app plugin with the same secret under secureJsonData.apiKey.
ASSISTANT_API_KEY=
ASSISTANT_ALLOWED_ORIGINS=http://localhost:3000

# Model Configuration
MODEL_PROVIDER=ollama
MODEL_NAME=kimik2.6
MODEL_BASE_URL=http://localhost:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Debugging (debugpy)
DEBUGPY_ENABLED=false
DEBUGPY_HOST=0.0.0.0
DEBUGPY_PORT=5678
DEBUGPY_WAIT_FOR_CLIENT=false

# Grafana MCP
# Mint at: Grafana UI -> Administration -> Service accounts -> Add service account -> Add token
GRAFANA_SERVICE_ACCOUNT_TOKEN=
GRAFANA_URL=http://grafana:3000

# OpenSearch datasource UID provisioned in grafana/provisioning/datasources/opensearch.yaml.
# The agent uses this exact value when generating dashboard panel targets.
OPENSEARCH_DATASOURCE_UID=opensearch-default

# Logfire (observability). Leave LOGFIRE_TOKEN empty to keep traces local.
# LOGFIRE_SEND=false to disable shipping even when a token is set.
LOGFIRE_TOKEN=
LOGFIRE_SEND=if-token-present
LOGFIRE_CONSOLE=false

# Optional: API keys for other services
# ANTHROPIC_API_KEY=your-anthropic-api-key
